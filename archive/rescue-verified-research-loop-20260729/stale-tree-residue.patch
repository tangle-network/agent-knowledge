-  let cursor = node.start
-  for (const edit of edits) {
-    if (edit.start < cursor) continue
-    text += module.source.slice(cursor, edit.start) + edit.text
-    cursor = edit.end
-  }
-  text += module.source.slice(cursor, node.end)
