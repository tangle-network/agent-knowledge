-    maxRecoveryAttempts: options.maxRecoveryAttempts ?? 1_000,
-    maxRecoveryRetriesPerAttempt:
-      options.maxRecoveryRetriesPerAttempt ?? DEFAULT_MEMORY_RECOVERY_RETRIES_PER_ATTEMPT,
