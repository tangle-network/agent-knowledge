-  if (snapshot.snapshotDigest !== reference.snapshotDigest) {
-    throw new Error(
-      `knowledge visibility artifact '${artifact.uri}' holds snapshot ${snapshot.snapshotDigest}, not ${reference.snapshotDigest}`,
-    )
-  }
