-          local: node.declaration?.type === 'Identifier' ? node.declaration.name : null,
-          kind: 'value',
-          source: null,
-          node: node.declaration,
-        })
-        break
-      default:
-        throw new Error(`${file} uses unhandled export form ${node.type}`)
-    }
-  }
-  const module = {
-    file,
-    source,
-    comments: parsed.comments,
-    imports,
-    declarations,
-    exported,
-    starSources,
-  }
-  modules.set(file, module)
-  return module
-}
